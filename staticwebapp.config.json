{
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/icons/*",
      "/*.js",
      "/*.json",
      "/*.webmanifest"
    ]
  }
}